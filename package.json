{
  "name": "flowforge",
  "version": "1.0.0",
  "description": "An infinite-canvas AI creation workbench: reference edges, immutable run snapshots, mock-first generation with optional real providers, all local-first.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archibald-nice/flowforge.git"
  },
  "keywords": [
    "ai",
    "canvas",
    "creative-tools",
    "react",
    "react-flow",
    "local-first",
    "generative-ai"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "benchmark": "pnpm build && playwright test --config playwright.benchmark.config.ts",
    "licenses": "node scripts/license-inventory.mjs",
    "fixtures": "node scripts/create-fixtures.mjs",
    "server": "node server/index.ts",
    "start": "node server/index.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "homepage": "https://flowforge-beige-chi.vercel.app/"
}
