# FlowForge provider configuration.
#
# Copy this file to `.env.local` and fill in real values to enable real
# generation. With everything empty the app runs in mock mode: no keys are
# needed and every result is labelled `simulated`.
#
# SECURITY: keys are only ever read by the local Node dev server / proxy
# (`src/server/proxy.ts`). The browser receives inlined booleans like
# `ARK_ENABLED` / `SPEECH_ENABLED`, never the key material. Never commit
# `.env.local`.

# --- Ark (Volcano Ark) ------------------------------------------------------
# API key for the Ark console. Real image runs bill per call; image generation
# uses this key directly, video and text use their dedicated endpoints below.
ARK_API_KEY=
# Master switch for real image generation (1 = on, empty = off).
ARK_ENABLED=
# Inference endpoint ID for image models (Ark console, e.g. ep-XXXXXXXX).
# The browser only knows a placeholder id; this value is substituted by the
# server so an account resource id never ships in the bundle.
ARK_IMAGE_ENDPOINT=
# Inference endpoint ID for video models (Ark console, e.g. ep-XXXXXXXX).
ARK_VIDEO_ENDPOINT=
# Master switch for real video generation (task submit -> poll -> download).
ARK_VIDEO_ENABLED=
# Inference endpoint ID for text models.
ARK_TEXT_ENDPOINT=
# Master switch for real text generation (one chat completion, no retry).
ARK_TEXT_ENABLED=

# --- Speech (Doubao speech) -------------------------------------------------
# API key for the speech provider. Real audio bills per minute.
SPEECH_API_KEY=
# Speech application ID issued by the console.
SPEECH_APP_ID=
# Master switch for real speech generation (1 = on, empty = off).
SPEECH_ENABLED=

# --- Self-hosting (`pnpm build && pnpm server`, or Docker) -------------------
# Port for the standalone server (also serves dist/).
PORT=8787
# Off by default: only loopback callers may trigger real generation. Set to 1
# to accept remote callers — anyone who can reach the port can spend credits.
PROXY_ALLOW_REMOTE=
